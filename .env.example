# HTTP server port (defaults to 3000)
PORT=3000

# Runtime environment: development or production
NODE_ENV=development

# Public application base URL
APP_URL=

# PostgreSQL connection string for production (leave empty to use local SQLite)
DATABASE_URL=

# Optional PEM-encoded CA certificate for TLS connections to PostgreSQL
PG_CA_CERT=

# Local SQLite database file path when DATABASE_URL is unset
DB_PATH=./data/mlibrary.db
